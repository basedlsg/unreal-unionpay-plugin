# UnionPay Backend Services Environment Configuration

# =============================================================================
# SECURITY KEYS (CHANGE THESE IN PRODUCTION!)
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-with-32-chars-min
ENCRYPTION_KEY=your-encryption-key-32-characters-long-change-this
WEBHOOK_SECRET=your-webhook-secret-for-secure-notifications

# =============================================================================
# PAYMENT PROVIDER API KEYS
# =============================================================================

# UnionPay Direct API (if available)
UNIONPAY_MERCHANT_ID=your-unionpay-merchant-id
UNIONPAY_API_KEY=your-unionpay-api-key
UNIONPAY_SANDBOX_URL=https://sandbox.unionpay.com/api/v1
UNIONPAY_PRODUCTION_URL=https://api.unionpay.com/api/v1

# PPRO UnionPay SecurePay
PPRO_API_KEY=your-ppro-api-key
PPRO_MERCHANT_ID=your-ppro-merchant-id
PPRO_SANDBOX_URL=https://sandbox.ppro.com/api/v1
PPRO_PRODUCTION_URL=https://api.ppro.com/api/v1

# Mastercard Gateway
MASTERCARD_API_KEY=your-mastercard-api-key
MASTERCARD_MERCHANT_ID=your-mastercard-merchant-id
MASTERCARD_SANDBOX_URL=https://sandbox-api.mastercard.com
MASTERCARD_PRODUCTION_URL=https://api.mastercard.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Service-specific Database URLs
PAYMENT_DATABASE_URL=postgresql://unionpay:unionpaypass@postgres:5432/unionpay
AUTH_DATABASE_URL=postgresql://unionpay:unionpaypass@postgres:5432/unionpay
FRAUD_DATABASE_URL=postgresql://unionpay:unionpaypass@postgres:5432/unionpay

# Base Postgres Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=unionpay
POSTGRES_USER=unionpay
POSTGRES_PASSWORD=unionpaypass

# Database Pool Configuration
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=300
DB_POOL_MAX_LIFETIME=1800

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Service-specific Redis URLs
PAYMENT_REDIS_URL=redis://:redispass@redis:6379/0
AUTH_REDIS_URL=redis://:redispass@redis:6379/1
FRAUD_REDIS_URL=redis://:redispass@redis:6379/2

# Base Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# Redis Session Configuration
REDIS_SESSION_TTL=3600
REDIS_CACHE_TTL=1800

# =============================================================================
# EMAIL/SMS NOTIFICATION CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@unionpay-plugin.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=unionpay-logs

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=8090

# Jaeger Tracing
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_ENABLED=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_REQUESTS_PER_DAY=10000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourgame.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key

# SSL/TLS Configuration
SSL_CERT_PATH=/certs/server.crt
SSL_KEY_PATH=/certs/server.key
SSL_CA_PATH=/certs/ca.crt

# =============================================================================
# FRAUD DETECTION CONFIGURATION
# =============================================================================
FRAUD_DETECTION_ENABLED=true
FRAUD_MODEL_PATH=/models/fraud_detection_model.h5
FRAUD_THRESHOLD_HIGH=0.8
FRAUD_THRESHOLD_MEDIUM=0.5

# Machine Learning Model Configuration
ML_MODEL_UPDATE_INTERVAL=3600
ML_TRAINING_DATA_RETENTION=30

# =============================================================================
# PAYMENT PROCESSING CONFIGURATION
# =============================================================================

# Transaction Limits
MIN_TRANSACTION_AMOUNT=0.01
MAX_TRANSACTION_AMOUNT=10000.00

# Supported Currencies
SUPPORTED_CURRENCIES=USD,EUR,CNY,JPY,GBP,CAD,AUD,SGD,HKD

# Payment Methods
SUPPORTED_PAYMENT_METHODS=unionpay,visa,mastercard,amex

# Transaction Timeout
PAYMENT_TIMEOUT_SECONDS=300
CALLBACK_TIMEOUT_SECONDS=30

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Cache TTL Settings (in seconds)
CACHE_USER_SESSION_TTL=3600
CACHE_PAYMENT_METHOD_TTL=1800
CACHE_TRANSACTION_STATUS_TTL=300
CACHE_FRAUD_ANALYSIS_TTL=600

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_TIMEOUT=30

# =============================================================================
# DEVELOPMENT/TESTING CONFIGURATION
# =============================================================================
ENVIRONMENT=development
DEBUG_MODE=true
TEST_MODE=false

# API Versioning
API_VERSION=v1
API_BASE_PATH=/api/v1

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# KUBERNETES/DEPLOYMENT CONFIGURATION
# =============================================================================
NAMESPACE=unionpay
SERVICE_NAME=unionpay-backend
REPLICA_COUNT=3

# Resource Limits
MEMORY_LIMIT=512Mi
CPU_LIMIT=500m
MEMORY_REQUEST=256Mi
CPU_REQUEST=250m

# =============================================================================
# AWS/CLOUD CONFIGURATION (if using cloud services)
# =============================================================================
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3 Configuration
S3_BUCKET_NAME=unionpay-documents
S3_REGION=us-west-2

# KMS Configuration
KMS_KEY_ID=your-kms-key-id

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true

# =============================================================================
# KONG GATEWAY CONFIGURATION
# =============================================================================
KONG_PG_DB=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=kongpass

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# MINIO CONFIGURATION
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_EXPIRATION=3600